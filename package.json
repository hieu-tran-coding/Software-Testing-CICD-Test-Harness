{
  "name": "software-testing-cicd-realworld-sut",
  "version": "1.0.0",
  "description": "RealWorld Conduit API implementation with comprehensive Jest Unit & SuperTest Integration Test Harness for CI/CD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --testPathPattern=test/unit --coverage",
    "test:api": "jest --testPathPattern=test/integration --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:ci": "jest --runInBand --coverage --reporters=default --reporters=jest-junit"
  },
  "keywords": [
    "realworld",
    "conduit",
    "express",
    "jest",
    "supertest",
    "ci-cd",
    "test-harness"
  ],
  "author": "Nguyen Le Huu Dien (23120233)",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "collectCoverageFrom": [
      "src/models/**/*.js",
      "src/utils/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
